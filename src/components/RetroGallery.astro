---
// RetroBB featured card with skin/theme gallery.
// Swap in real PNGs later: /screenshots/retrobb-{skin}-{theme}.png (keep .svg fallback until then).
import site from '../data/site.json';
const gallerySkins = ['classic', 'midnight', 'silver'];
// NOTE: BASE_URL has no trailing slash — normalize before joining paths.
const rawBase = import.meta.env.BASE_URL || '/';
const assetBase = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const initialPng = `${assetBase}screenshots/retrobb-classic-light.png`;
const initialSvg = `${assetBase}screenshots/retrobb-classic-light.svg`;
---
<section class="panel" id="retrobb">
  <div class="bar">★ Featured — RetroBB <span style="font-weight:normal">· beta · v0.3 · pure PHP</span></div>
  <div class="body flush">
    <div class="gallery" data-gallery-skin="classic">
      <div class="miniswitch">Skin:
        {gallerySkins.map((s) => <button data-gskin={s} aria-pressed={s === 'classic' ? 'true' : 'false'}>{s[0].toUpperCase() + s.slice(1)}</button>)}
        <span style="margin-left:auto;color:var(--muted)">Theme follows hub · Light/Dark</span>
      </div>
      <img src={initialPng} onerror={`this.onerror=null;this.src='${initialSvg}'`} alt="RetroBB classic skin, light theme" loading="lazy" width="1020" height="560" />
    </div>
    <div class="body">
      <h2 style="margin:0 0 4px">RetroBB — the old-school forum, reborn</h2>
      <p style="margin:0 0 8px;color:var(--muted)">Gradient title bars, postbit profiles, BBCode — rebuilt from scratch in modern PHP. MIT. No accounts to create, no cloud to join: you host it, you own it.</p>
      <div class="badges">
        <span class="badge">PHP 8.1+</span><span class="badge">MySQL 8 / MariaDB</span>
        <span class="badge">no build step</span><span class="badge warn">beta</span>
      </div>
      <div class="btnrow">
        <a class="btn" href="https://github.com/techwiz18/retrobb" rel="noopener">Code</a>
        {site.forumEnabled ? (
          <a class="btn" href={site.forumUrl} rel="noopener">Live forum</a>
        ) : (
          <span class="btn" aria-disabled="true" title="Deploy to forum subdomain to enable">Live forum · soon</span>
        )}
        <a class="btn ghost" href="https://github.com/techwiz18/retrobb#readme" rel="noopener">Install docs</a>
      </div>
      <details>
        <summary style="cursor:pointer;margin-top:8px">Install (5 minutes)</summary>
        <table class="specs">
          <tr><td><strong>Needs</strong></td><td>Any shared host or VPS with PHP 8.1+ and MySQL 8+ / MariaDB 10.6+</td></tr>
          <tr><td><strong>cPanel</strong></td><td>Upload release zip to <code class="inline">public_html</code>, extract, point domain at <code class="inline">public_html/retrobb/public</code>, run web installer.</td></tr>
          <tr><td><strong>Local</strong></td><td><code class="inline">php bin/migrate.php --seed &amp;&amp; php -S localhost:8000 -t public/</code></td></tr>
        </table>
      </details>
      <p style="font-size:12px;color:var(--muted)">Screenshots: drop real exports at <code class="inline">public/screenshots/retrobb-[skin]-[light|dark].png</code> and update the <code class="inline">img</code> swap to <code class="inline">.png</code> when ready — placeholders live there now.</p>
    </div>
  </div>
</section>
