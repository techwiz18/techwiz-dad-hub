/* Docs-only featured card: no demo button by request. */
---
<section class="panel" id="open-credits">
  <div class="body">
    <div class="eyebrow">★ XenForo 2.3+ addon · MIT</div>
    <h2>OpenCredits — credits for XenForo</h2>
    <p class="standfirst">A free credits economy for XenForo: earn, wallet, transfers, trophies. Docs only — it needs a paid XenForo license, so there's no live demo.</p>
    <p class="spec">Earn — thread $5 · reply $1 · reaction $2 · visit $5/day<br />Wallet — postbit, profile, <code class="inline">/credits/</code>, <code class="inline">/credits/transfer</code></p>
    <div class="btnrow">
      <a class="btn solid" href="https://github.com/techwiz18/open-credits" target="_blank" rel="noopener">Code</a>
      <a class="btn" href="https://xenforo.com/community/resources/open-credits-free.10868/" target="_blank" rel="noopener">XenForo resource</a>
      <a class="btn" href="https://github.com/techwiz18/open-credits/blob/main/docs/API.md" target="_blank" rel="noopener">API docs</a>
      <a class="btn" href="https://github.com/techwiz18/open-credits#readme" target="_blank" rel="noopener">Install</a>
    </div>
    <details>
      <summary>Integrate (spend/award from your add-on)</summary>
<pre>{"// Award or charge via the transaction service (always logged)\n/** @var \\OpenCredits\\Credits\\Service\\Transact $credits */\n$credits = \\XF::app()->service('OpenCredits\\Credits:Transact');\nif ($credits->getBalance($userId, $currencyId) >= $price) {\n    $credits->adjust($userId, $currencyId, -$price, 'my_addon_purchase', $contentId, 'Entry fee');\n}\n// Listen to `oc_credits_adjust` ($userId, $currencyId, $amount, $trigger, $contentId)"}</pre>
    </details>
  </div>
</section>
