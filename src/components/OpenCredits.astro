---
/* Docs-only featured card: no demo button by request. */
---
<section class="panel" id="open-credits">
  <div class="bar">Featured · XenForo addon</div>
  <div class="body">
    <h2>OpenCredits — credits for XenForo</h2>
    <p class="standfirst">Free (MIT) credits economy for XenForo 2.3+: earn, wallet, transfers, trophies. Docs only — requires a paid XenForo license, so no live demo.</p>
    <table class="specs">
      <tr><td>New thread $5 · Reply $1</td><td>Reaction $2 · Daily visit $5</td></tr>
      <tr><td>Wallet</td><td>postbit · profile · <code class="inline">/credits/</code> · <code class="inline">/credits/transfer</code></td></tr>
    </table>
    <div class="btnrow">
      <a class="btn solid" href="https://github.com/techwiz18/open-credits" rel="noopener">Code</a>
      <a class="btn" href="https://github.com/techwiz18/open-credits/blob/main/docs/API.md" rel="noopener">API docs</a>
      <a class="btn" href="https://github.com/techwiz18/open-credits#readme" rel="noopener">Install</a>
    </div>
    <details>
      <summary>Integrate (spend/award from your add-on)</summary>
<pre>{"// Award or charge via the transaction service (always logged)\n/** @var \\OpenCredits\\Credits\\Service\\Transact $credits */\n$credits = \\XF::app()->service('OpenCredits\\Credits:Transact');\nif ($credits->getBalance($userId, $currencyId) >= $price) {\n    $credits->adjust($userId, $currencyId, -$price, 'my_addon_purchase', $contentId, 'Entry fee');\n}\n// Listen to `oc_credits_adjust` ($userId, $currencyId, $amount, $trigger, $contentId)"}</pre>
    </details>
  </div>
</section>
