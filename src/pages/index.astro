---
import Base from '../layouts/Base.astro';
import { BASE, url } from '../lib/base';
---
<Base title="techwiz.dad — project hub">
  <section class="hero">
    <h1>techwiz.dad</h1>
    <p>Old-school soul, modern code. A central landing page for my GitHub projects — scan in 30 seconds, jump to the right repo.</p>
    <div class="btnrow">
      <a class="btn solid" href={url('projects/')}>Browse projects</a>
      <a class="btn" href="https://github.com/techwiz18" target="_blank" rel="noopener">All repos on GitHub</a>
    </div>
  </section>

  <h2 class="sect" id="featured">Featured</h2>

  <a class="teaser" href={url('projects/retrobb/')}>
    <span class="teaser-text">
      <span class="eyebrow">★ beta v0.3 · pure PHP + MySQL</span>
      <strong>RetroBB — the old-school forum, reborn</strong>
      <span class="muted">Early-2000s soul, modern PHP underneath. MIT. You host it, you own it.</span>
      <span class="more">View showcase →</span>
    </span>
    <img src={`${BASE}screenshots/retrobb-classic-light.png`} alt="RetroBB forum in classic skin" loading="lazy" width="1020" height="560" />
  </a>

  <a class="teaser" href={url('projects/open-credits/')}>
    <span class="teaser-text">
      <span class="eyebrow">★ XenForo 2.3+ addon · MIT</span>
      <strong>OpenCredits — credits for XenForo</strong>
      <span class="muted">Earn, wallet, transfers, trophies. Docs only — needs a paid XenForo license.</span>
      <span class="more">View docs →</span>
    </span>
  </a>

  <p class="strip">Community — our forum launches with RetroBB. <a href={url('community/')}>Learn more →</a></p>
</Base>
