---
import site from '../data/site.json';
import { url } from '../lib/base';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'techwiz.dad — project hub', description = 'Old-school soul, modern code. Projects by techwiz.dad.' } = Astro.props;
const skin = site.defaultSkin ?? 'classic';
// Asset base (e.g. /techwiz-dad-hub/ on Pages, / on apex). Exposed to client JS.
// NOTE: import.meta.env.BASE_URL has NO trailing slash — normalize it.
const rawBase = import.meta.env.BASE_URL || '/';
const assetBase = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
---
<!doctype html>
<html lang="en" data-skin={skin} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Restore skin/theme before paint; Auto resolves via matchMedia.
      try {
        var s = localStorage.getItem('hub-skin') || document.documentElement.dataset.skin || 'classic';
        var t = localStorage.getItem('hub-theme') || 'auto';
        var resolved = t;
        if (t === 'auto') resolved = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.skin = s;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themeMode = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap head-main">
        <a class="brand" href={assetBase}><span class="floppy" aria-hidden="true"></span> techwiz.dad</a>
        <nav class="mainnav" aria-label="Main">
          <a href={url('projects/')}>Projects</a>
          <a href={url('community/')} target="_blank" rel="noopener">Community</a>
          <a href="https://github.com/techwiz18" target="_blank" rel="noopener">GitHub</a>
          {site.forumEnabled && (
            <a href={site.forumUrl} target="_blank" rel="noopener">Forum</a>
          )}
        </nav>
      </div>
      <div class="wrap head-util">
        <div class="switchers" role="group" aria-label="Skin and theme">
          <span class="grp" id="skin-switch">Skin:
            <button data-skin-btn="classic">Classic</button><button data-skin-btn="midnight">Midnight</button><button data-skin-btn="silver">Silver</button>
          </span>
          <span class="grp" id="theme-switch">Theme:
            <button data-theme-btn="light">Light</button><button data-theme-btn="dark">Dark</button><button data-theme-btn="auto">Auto</button>
          </span>
        </div>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div>Powered by curiosity · <strong>techwiz.dad</strong> · Old-school soul, modern code · 2026</div>
      <div>Hub is static · Forum lives at {site.forumUrl}</div>
    </footer>
    <script is:inline define:vars={{ assetBase }}>
      (function () {
        var BASE = assetBase || '/';
        var root = document.documentElement;
        function paint() {
          var s = localStorage.getItem('hub-skin') || root.dataset.skin || 'classic';
          var t = localStorage.getItem('hub-theme') || root.dataset.themeMode || 'auto';
          var r = t === 'auto' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : t;
          root.dataset.skin = s; root.dataset.theme = r; root.dataset.themeMode = t;
          document.querySelectorAll('[data-skin-btn]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.dataset.skinBtn === s ? 'true' : 'false');
          });
          document.querySelectorAll('[data-theme-btn]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.dataset.themeBtn === t ? 'true' : 'false');
          });
          // RetroBB galleries: each dimension (skin/theme) follows the hub
          // while set to 'hub', freezes when picked explicitly.
          document.querySelectorAll('[data-gallery-skin]').forEach(updateGalleryImg);
        }
        function resolvedSkin(g) {
          return g.dataset.gallerySkin && g.dataset.gallerySkin !== 'hub'
            ? g.dataset.gallerySkin
            : (root.dataset.skin || 'classic');
        }
        function resolvedTheme(g) {
          return g.dataset.galleryTheme && g.dataset.galleryTheme !== 'hub'
            ? g.dataset.galleryTheme
            : (root.dataset.theme || 'light');
        }
        function updateGalleryImg(g) {
          var skin = resolvedSkin(g);
          var theme = resolvedTheme(g);
          var img = g.querySelector('img');
          if (img) {
            var png = BASE + 'screenshots/retrobb-' + skin + '-' + theme + '.png';
            var svg = BASE + 'screenshots/retrobb-' + skin + '-' + theme + '.svg';
            img.onerror = function () { img.onerror = null; img.src = svg; };
            img.src = png;
            img.alt = 'RetroBB ' + skin + ' skin, ' + theme + ' theme';
          }
          g.querySelectorAll('[data-gskin]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.dataset.gskin === (g.dataset.gallerySkin || 'hub') ? 'true' : 'false');
          });
          g.querySelectorAll('[data-gtheme]').forEach(function (b) {
            b.setAttribute('aria-pressed', b.dataset.gtheme === (g.dataset.galleryTheme || 'hub') ? 'true' : 'false');
          });
        }
        document.addEventListener('click', function (e) {
          var sb = e.target.closest && e.target.closest('[data-skin-btn]');
          var tb = e.target.closest && e.target.closest('[data-theme-btn]');
          var gs = e.target.closest && e.target.closest('[data-gskin]');
          var gt = e.target.closest && e.target.closest('[data-gtheme]');
          if (sb) { try { localStorage.setItem('hub-skin', sb.dataset.skinBtn); } catch (err) {} paint(); }
          if (tb) { try { localStorage.setItem('hub-theme', tb.dataset.themeBtn); } catch (err) {} paint(); }
          if (gs) {
            var g = gs.closest('[data-gallery-skin]');
            if (g) { g.dataset.gallerySkin = gs.dataset.gskin; updateGalleryImg(g); }
          }
          if (gt) {
            var h = gt.closest('[data-gallery-skin]');
            if (h) { h.dataset.galleryTheme = gt.dataset.gtheme; updateGalleryImg(h); }
          }
        });
        try { matchMedia('(prefers-color-scheme: dark)').addEventListener('change', paint); } catch (e) {}
        paint();
      })();
    </script>
  </body>
</html>
